<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The repository restores from nuget.org only. PayGate packages are referenced as projects
    inside this repo, so it never needs the private feed or its credentials.

    Both lists are cleared because the machine-wide config on some developer machines already
    defines sources and source mappings, and those must not leak into this build.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
