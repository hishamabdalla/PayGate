<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- PayGate packages come only from the locally packed folder; everything else from nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-paygate" value="../../artifacts/packages" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-paygate">
      <package pattern="PayGate" />
      <package pattern="PayGate.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
