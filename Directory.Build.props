<Project>

  <!--
    Repository-wide build settings. At least as strict as the strictest consumer (manga-store):
    warnings are errors, latest-recommended analyzers, code style enforced at build time.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>

    <!-- Reproducible restores: lock files are committed and CI restores in locked mode. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Only projects under src/ produce packages; src/Directory.Build.props turns this on. -->
    <IsPackable>false</IsPackable>

    <!--
      GitHub Packages does not accept .snupkg symbol packages, so the PDB is embedded in the
      assembly. Together with SourceLink this still gives step-into debugging.
    -->
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Package metadata shared by every package. -->
  <PropertyGroup>
    <Authors>PayGate contributors</Authors>
    <Company>PayGate</Company>
    <Product>PayGate</Product>
    <Copyright>Copyright (c) PayGate contributors. All rights reserved.</Copyright>
    <RepositoryUrl>https://github.com/hishamabdalla/PayGate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/hishamabdalla/PayGate</PackageProjectUrl>
    <PackageTags>payments;payment-gateway;kashier;paymob;fawry;stripe;webhooks</PackageTags>
  </PropertyGroup>

</Project>
